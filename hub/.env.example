# =============================================================================
# APEx Hub — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Neon, Supabase, Railway, or local)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apex_hub"
# Direct connection URL (used by Prisma migrations, bypasses pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/apex_hub"

# -----------------------------------------------------------------------------
# Redis (for BullMQ job queues and caching)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Optional: Redis with auth
# REDIS_URL="redis://:password@localhost:6379"
# Optional: Upstash Redis REST API (serverless alternative)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# Generate secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional — configure as needed)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Optional: Default model overrides
# ANTHROPIC_DEFAULT_MODEL="claude-opus-4-5"
# OPENAI_DEFAULT_MODEL="gpt-4o"

# -----------------------------------------------------------------------------
# File Storage
# Supported types: "local" | "s3"
# -----------------------------------------------------------------------------
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 (when STORAGE_TYPE="s3")
AWS_BUCKET_NAME=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: CloudFront CDN URL for public assets
# AWS_CLOUDFRONT_URL=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="APEx Hub"

# Feature flags
# NEXT_PUBLIC_ENABLE_ANALYTICS="false"
# NEXT_PUBLIC_ENABLE_DEBUG_PANEL="false"

# -----------------------------------------------------------------------------
# Email (optional — for notifications and invites)
# Supported: "resend" | "smtp" | "sendgrid"
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@yourdomain.com"

# SMTP (alternative)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# -----------------------------------------------------------------------------
# Integrations (optional)
# -----------------------------------------------------------------------------
# Slack
# SLACK_BOT_TOKEN=""
# SLACK_SIGNING_SECRET=""

# Linear
# LINEAR_API_KEY=""

# Notion
# NOTION_API_KEY=""

# HubSpot
# HUBSPOT_ACCESS_TOKEN=""

# Stripe (for billing if needed)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# -----------------------------------------------------------------------------
# Monitoring & Observability (optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# Posthog (product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=""
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Rate limiting (requests per minute per IP)
# RATE_LIMIT_RPM="60"
# Encryption key for storing integration credentials
# ENCRYPTION_KEY="32-byte-hex-string-generate-with-openssl-rand-hex-32"
